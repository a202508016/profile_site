<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>개인 프로필 소개</title>
</head>
<body>
    <h1><%= profile.name %>의 프로필 페이지</h1>
    <p>학번: <%= profile.studentId %></p>

    <hr>

    <section>
        <h2>자기소개</h2>
        <p><%= profile.intro %></p>
    </section>

    <section>
        <h2>보유 기술 / 배우는 중인 기술</h2>
        <ul>
            <% profile.skills.forEach(function(skill) { %>
                <li><%= skill %></li>
            <% }); %>
        </ul>
    </section>

    <section>
        <h2>취미</h2>
        <ul>
            <% profile.hobbies.forEach(function(hobby) { %>
                <li><%= hobby %></li>
            <% }); %>
        </ul>
    </section>
</body>
</html>
